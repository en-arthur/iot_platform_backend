# =============================================================================
# DeviceStack Technologies Backend Configuration
# =============================================================================

ENVIRONMENT=development
PORT=8000

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MQTT Broker (Mosquitto on VPS or local Docker)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASSWORD=adminpassword
MQTT_USE_TLS=false

# AI Model Provider (Gemini by default)
AI_MODEL_PROVIDER=gemini
AI_MODEL_NAME=gemini-2.5-flash
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Sandbox Runner Provider (Exclusively E2B)
SANDBOX_PROVIDER=e2b
E2B_API_KEY=e2b_...

# WorkersCraft Cloud Service
WORKERSCRAFT_URL=http://localhost:8001
